# Everything here is optional – models and storage are configured in the dashboard.

# --- Dashboard -----------------------------------------------------------------
# The first visit creates the admin account; after that everyone signs in.
# Only turn sign-in off behind your own authenticating reverse proxy.
# SCRAPEFLOW_AUTH_DISABLED=false
# SCRAPEFLOW_SECURE_COOKIES=           # empty = secure cookies only over HTTPS; set true behind a TLS proxy
# SCRAPEFLOW_PORT=8000

# --- Crawling ------------------------------------------------------------------
# SCRAPEFLOW_CRAWL_DELAY=0.5            # seconds between page requests
# SCRAPEFLOW_RESPECT_ROBOTS=true
# SCRAPEFLOW_MAX_PARALLEL_CHECKS=2
# SCRAPEFLOW_REQUEST_TIMEOUT=30

# --- Files ---------------------------------------------------------------------
# SCRAPEFLOW_FILES_DIR=/downloads        # default folder of the "Local folder" storage
# SCRAPEFLOW_MAX_FILE_MB=500
# SCRAPEFLOW_MAX_DOWNLOADS_PER_CHECK=1000

# --- AI model defaults (can also be set on the Model providers page) -----------
# SCRAPEFLOW_AI_PROVIDER=openai
# SCRAPEFLOW_AI_BASE_URL=http://host.docker.internal:11434/v1
# SCRAPEFLOW_AI_MODEL=qwen2.5:7b
# SCRAPEFLOW_AI_API_KEY=
